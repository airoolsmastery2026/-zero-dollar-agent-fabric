# Z.ai free-tier adapter configuration
# Copy to an ignored local env file and set the key locally. Never commit secrets.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_FREE_MODEL_PRIMARY=glm-4.7-flash
ZAI_FREE_MODEL_FALLBACK=glm-4.5-flash

# GLM-5.2 remains blocked from automatic routing.
ZAI_GLM52_TRIAL_ENABLED=false
ZAI_CODING_PLAN_ENABLED=false
