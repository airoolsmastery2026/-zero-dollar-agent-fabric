{
  "schema": "dhp.configurator.sources.v1",
  "sources": {
    "products": "res://data/products.json",
    "materials": "res://data/materials.json",
    "accessories": "res://data/accessories.json",
    "images": "res://data/images.json",
    "initial_configuration": "res://data/initial-config.json"
  },
  "external_adapters": {
    "dhp_aios": {
      "enabled": false,
      "mode": "http-json",
      "base_url": "",
      "allowed_domains": [],
      "timeout_sec": 8,
      "endpoints": {
        "products": "/api/configurator/products",
        "materials": "/api/configurator/materials",
        "accessories": "/api/configurator/accessories",
        "images": "/api/configurator/images"
      },
      "schemas": {
        "products": "dhp.product-db.snapshot.v1",
        "materials": "dhp.material-db.snapshot.v1",
        "accessories": "dhp.accessory-db.snapshot.v1",
        "images": "dhp.image-db.snapshot.v1"
      }
    }
  }
}
